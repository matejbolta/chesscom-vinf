{
  "manifest_version": 3,
  "name": "ChessComVINF",
  "short_name": "VINF",
  "version": "0.15.5",
  "description": "A focused, infinitely improving Chess.com homepage with configurable one-click time controls.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel"],
  "action": {
    "default_title": "ChessComVINF settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/home*"],
      "js": ["content-script.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
